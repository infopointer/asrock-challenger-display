# ASRock Challenger Digital AIO pump display (USB 26ce:0a13).
# Only the asrock-challenger group may open its hidraw nodes; the display service
# (systemd DynamicUser) joins that group via SupplementaryGroups=. The raw USB node
# keeps the system default, since the service never uses it.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="26ce", ATTRS{idProduct}=="0a13", GROUP="asrock-challenger", MODE="0660"
